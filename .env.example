# ==============================================================================
# 80/20 AI DIALER — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and populate with your service credentials.
# NEVER commit .env.local or real secrets to source control.

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Provider Mode: 'development' | 'live' | 'test'
RM_PROVIDER_MODE=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_ORG_ID=a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

# ------------------------------------------------------------------------------
# 2. SUPABASE (Database & Authentication)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. RETELL AI (AI Voice Engine & Conversation Intelligence)
# ------------------------------------------------------------------------------
AI_VOICE_RUNTIME=retell
RETELL_CAMPAIGN_MODE=canary
# Comma-separated list of approved test phone numbers / lead IDs for canary testing
RETELL_CANARY_ALLOWLIST=+18005550199
RETELL_API_KEY=your_retell_api_key
RETELL_AGENT_ID=your_retell_agent_id
RETELL_DEFAULT_AGENT_ID=your_retell_default_agent_id
RETELL_PHONE_NUMBER=+18005550199
RETELL_API_BASE_URL=https://api.retellai.com
RETELL_WEBHOOK_SECRET=your_retell_webhook_secret

# ------------------------------------------------------------------------------
# 4. TWILIO (Telephony, Carrier PSTN & WebRTC Audio)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_API_KEY=your_twilio_api_key
TWILIO_API_SECRET=your_twilio_api_secret
TWILIO_TWIML_APP_SID=your_twilio_twiml_app_sid
TWILIO_PHONE_NUMBER=+18005550199

# ------------------------------------------------------------------------------
# 5. RESEND (Automated Follow-up Emails)
# ------------------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=sales@yourverifieddomain.com
RESEND_REPLY_TO=support@yourverifieddomain.com
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret
EMAIL_UNSUBSCRIBE_SECRET=your_email_unsubscribe_hmac_secret

# ------------------------------------------------------------------------------
# 6. ANTHROPIC CLAUDE (Lead Qualification & Script Intelligence)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 7. ELEVENLABS (Voice Synthesis & Audio Streaming - Fallback/Legacy Runtime)
# ------------------------------------------------------------------------------
ELEVENLABS_API_KEY=mock_elevenlabs_key_0000000000000000
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
